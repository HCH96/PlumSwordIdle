{
  "base_branch": "main",
  "loop_branch_prefix": "loop/",
  "task_branch_prefix": "task/",
  "worktree_path": "../PlumSwordIdle_loop",
  "default_bundle": "기본",
  "max_retries": 5,
  "test_command": "",
  "test_timeout_min": 30,
  "watch_interval_sec": 60,
  "agents": ["claude", "codex"],
  "limit_retry_after_min": 60,
  "usage_limit_patterns": {
    "claude": [
      "usage limit reached",
      "hit your (usage )?limit",
      "out of extra usage",
      "rate_limit_error"
    ],
    "codex": [
      "hit your usage limit",
      "usage limit has been reached",
      "usage_limit_reached",
      "rate_limit_exceeded"
    ]
  },
  "claude_command": "claude",
  "claude_timeout_min": 60,
  "transient_error_patterns": [
    "connection error",
    "network error",
    "fetch failed",
    "socket hang up",
    "ECONNRESET|ECONNREFUSED|ETIMEDOUT|ENOTFOUND|EAI_AGAIN",
    "overloaded",
    "internal server error",
    "service unavailable",
    "API Error.{0,20}\\b5\\d\\d\\b",
    "stream disconnected",
    "error sending request"
  ],
  "transient_retry_wait_sec": 300,
  "transient_max_repeats": 3,
  "claude_permission_mode": "dontAsk",
  "claude_allowed_tools": ["Read", "Edit", "Write", "Glob", "Grep", "Bash", "PowerShell"],
  "claude_disallowed_tools": [
    "Read(./.env)",
    "Edit(./.env)",
    "Write(./.env)",
    "Bash(git commit:*)",
    "Bash(git push:*)",
    "Bash(git checkout:*)",
    "Bash(git switch:*)",
    "Bash(git merge:*)",
    "Bash(git rebase:*)",
    "Bash(git reset:*)",
    "Bash(git branch:*)",
    "Bash(git stash:*)",
    "Bash(git tag:*)",
    "PowerShell(git commit *)",
    "PowerShell(git push *)",
    "PowerShell(git checkout *)",
    "PowerShell(git switch *)",
    "PowerShell(git merge *)",
    "PowerShell(git rebase *)",
    "PowerShell(git reset *)",
    "PowerShell(git branch *)",
    "PowerShell(git stash *)",
    "PowerShell(git tag *)"
  ],
  "codex_command": "codex",
  "codex_timeout_min": 60,
  "codex_sandbox": "workspace-write",
  "codex_extra_args": [
    "-c", "sandbox_workspace_write.exclude_tmpdir_env_var=true",
    "-c", "sandbox_workspace_write.exclude_slash_tmp=true"
  ]
}
